[importlinter]
root_packages =
    runner
    execution
    evaluator
    exec_eval
    parse
    reconstructor
    llm
    live_metrics
    constants
    prompts
    retry_v2
    execution_v2
    stages
    logging_core
    experiment_config

# ============================================================
# 1. PURE MODULE ISOLATION
# ============================================================

[importlinter:contract:parse-purity]
name = parse must be pure
type = forbidden
source_modules =
    parse
forbidden_modules =
    llm
    execution
    execution_v2
    evaluator
    retry_v2
    logging_core

[importlinter:contract:reconstructor-purity]
name = reconstructor must be pure
type = forbidden
source_modules =
    reconstructor
forbidden_modules =
    llm
    execution
    execution_v2
    evaluator
    retry_v2
    logging_core

[importlinter:contract:metrics-purity]
name = metrics must be pure
type = forbidden
source_modules =
    metrics_v2
forbidden_modules =
    llm
    execution
    execution_v2
    retry_v2
    logging_core

# ============================================================
# 2. EVALUATION ISOLATION (CRITICAL FOR LEG)
# ============================================================

[importlinter:contract:evaluator-isolation]
name = evaluator must not depend on execution
type = forbidden
source_modules =
    evaluator
forbidden_modules =
    execution
    execution_v2
    retry_v2
    runner

[importlinter:contract:oracle-isolation]
name = oracle must not depend on execution
type = forbidden
source_modules =
    oracle_inline
forbidden_modules =
    execution
    execution_v2
    retry_v2

# ============================================================
# 3. EXECUTION BOUNDARY
# ============================================================

[importlinter:contract:execution-boundary]
name = execution modules must not call evaluator
type = forbidden
source_modules =
    execution
    execution_v2
forbidden_modules =
    evaluator

# prevents feedback loops (huge source of bugs)

# ============================================================
# 4. RETRY ISOLATION (CRITICAL — you found duplication)
# ============================================================

[importlinter:contract:retry-boundary]
name = retry must not reimplement execution internals
type = forbidden
source_modules =
    retry_v2
forbidden_modules =
    parser_v2
    reconstructor
    evaluator_v2
    oracle_inline

# forces retry to go through pipeline instead of duplicating logic

# ============================================================
# 5. LLM BOUNDARY (STRICT)
# ============================================================

[importlinter:contract:llm-isolation]
name = only llm module can access external APIs
type = forbidden
source_modules =
    execution
    execution_v2
    evaluator
    oracle_inline
    retry_v2
forbidden_modules =
    openai
    anthropic

# ============================================================
# 6. LOGGING BOUNDARY (PREVENT SIDE-EFFECT SPREAD)
# ============================================================

[importlinter:contract:logging-isolation]
name = logging should not leak into pure modules
type = forbidden
source_modules =
    parse
    reconstructor
    metrics_v2
forbidden_modules =
    logging_core

# ============================================================
# 7. CONFIG BOUNDARY (CRITICAL FOR GRAPH MIGRATION)
# ============================================================

[importlinter:contract:config-isolation]
name = config must not be globally accessed by pure modules
type = forbidden
source_modules =
    parse
    reconstructor
    metrics_v2
forbidden_modules =
    experiment_config

# ============================================================
# 8. RUNNER IS TOP-LEVEL ONLY
# ============================================================

[importlinter:contract:runner-isolation]
name = runner should not be imported
type = forbidden
source_modules =
    execution
    execution_v2
    evaluator
    parse
    reconstructor
    retry_v2
forbidden_modules =
    runner

# ============================================================
# 9. STAGE LAYER CONTROL
# ============================================================

[importlinter:contract:stages-are-thin]
name = stages should not depend on heavy modules
type = forbidden
source_modules =
    stages
forbidden_modules =
    runner

# ============================================================
# 10. GRAPH RUNNER ISOLATION (FUTURE-PROOFING)
# ============================================================

[importlinter:contract:graph-runner-isolation]
name = graph runner must not depend on legacy pipeline
type = forbidden
source_modules =
    side_projects.graph_runner
forbidden_modules =
    execution_v2
    retry_v2
    runner
